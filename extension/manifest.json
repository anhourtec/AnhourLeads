{
  "manifest_version": 3,
  "name": "AnhourLeads — save person",
  "short_name": "Save person",
  "version": "0.1.0",
  "description": "Save the person on the page you are looking at into your own workspace, one at a time, after you review the details.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": {
    "default_title": "Save this person",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
