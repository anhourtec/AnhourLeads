{
  "name": "anhourleads",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3410",
    "build": "next build",
    "start": "next start -p 3410",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "prepare": "husky",
    "generate:presets": "ts-node -P tsconfig.scripts.json src/scripts/generate-theme-presets.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx --tsconfig tsconfig.json scripts/seed.ts",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui-desktop --project=ui-tablet --project=ui-mobile",
    "test:ui:isolated": "playwright test --config playwright.isolated.config.ts",
    "test": "playwright test",
    "scheduler": "tsx --conditions=react-server scripts/scheduler.ts",
    "domains:recheck": "tsx --conditions=react-server scripts/domains-recheck.ts",
    "crawler": "tsx --conditions=react-server scripts/crawler-worker.ts"
  },
  "lint-staged": {
    "*.{js,mjs,ts,jsx,tsx}": ["biome check --write --no-errors-on-unmatched"]
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@fullcalendar/react": "^7.1.1",
    "@hookform/resolvers": "^5.9.1",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-table": "^9.2.8",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "d3-geo": "^3.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "embla-carousel-react": "^8.6.0",
    "geist": "^1.7.2",
    "input-otp": "^1.5.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.55.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-resizable-panels": "^4.14.3",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "simple-icons": "^16.34.0",
    "sonner": "^2.0.8",
    "temporal-polyfill": "^1.0.5",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "vaul": "^1.1.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.1.5",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
