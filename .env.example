# ---------------------------------------------------------------------------
# AnhourLeads environment. Copy to `.env` for local development (`cp .env.example .env`)
# or to `deploy/.env` for production. Never commit real values.
# ---------------------------------------------------------------------------

# Database and cache (local values match docker-compose.yml)
DATABASE_URL=postgres://anhour:anhour_dev_password@127.0.0.1:48432/anhourleads
REDIS_URL=redis://:anhour_dev_redis@127.0.0.1:48379/0

# Better Auth. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public origin of the primary host (no trailing slash)
BETTER_AUTH_URL=http://localhost:3410

# Encrypts stored secrets such as mailbox SMTP passwords (openssl rand -base64 32).
# Changing it makes saved passwords unreadable.
SECRETS_ENCRYPTION_KEY=

# White-label hostnames
# Comma-separated hostnames that serve the installation's own brand (ports allowed).
APP_PRIMARY_HOSTS=localhost:3410,127.0.0.1:3410
# The CNAME target workspaces point their custom hostnames at (production), e.g. leads.example.com
APP_DOMAIN_TARGET=
# http in development, https in production (set by deploy/docker-compose.prod.yml)
APP_PROTOCOL=http
# true behind NGINX: trust X-Forwarded-Host / -For / -Proto
APP_TRUST_PROXY=false
# nginx (Let's Encrypt via certbot), cloudflare, or none (local development only)
APP_TLS_PROVIDER=none

# Outgoing mail (local: Mailpit)
SMTP_HOST=127.0.0.1
SMTP_PORT=48025
SMTP_FROM="AnhourLeads <no-reply@anhourleads.local>"

# Crawler
CRAWLER_USER_AGENT="AnhourLeadsBot/0.1 (+https://github.com/nishchayjeet/AnhourLeads)"
# Allow the crawler to fetch private / loopback addresses (tests only, never in production)
CRAWLER_ALLOW_PRIVATE_HOSTS=false

# Email verification: also probe the recipient's mail server with SMTP RCPT TO (never sends a message).
# Off by default — many providers block or tarpit probes and it can hurt your IP's reputation.
VERIFY_SMTP_PROBE=false

# Self sign-up on the primary hosts (creates a new workspace). false = invite only.
APP_ALLOW_SIGNUP=true

# Seed (npm run db:seed)
SEED_PLATFORM_ADMIN_EMAIL=admin@anhourleads.local
SEED_PLATFORM_ADMIN_PASSWORD=change-me-admin-password

LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Production compose only (deploy/.env, read by deploy/docker-compose.prod.yml). See docs/deployment-guide.md.
# ---------------------------------------------------------------------------
POSTGRES_USER=anhour
POSTGRES_PASSWORD=
POSTGRES_DB=anhourleads
REDIS_PASSWORD=
# cloudflare (Origin CA certificate in deploy/certs) or letsencrypt (certbot)
NGINX_CONF=letsencrypt
# letsencrypt starts the certbot service
COMPOSE_PROFILES=letsencrypt
ACME_EMAIL=
ACME_STAGING=false
CERT_SYNC_INTERVAL=900
# Entrypoint: skip migrations on start (run them as a one-off job instead)
SKIP_MIGRATIONS=false
STARTUP_WAIT_SECONDS=60
# Scheduler: comma-separated job names to run (empty = all), heartbeat file for the healthcheck
SCHEDULER_JOBS=
SCHEDULER_HEARTBEAT_FILE=/tmp/scheduler-heartbeat
